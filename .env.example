# GeoDeploy environment — copy to .env and fill in secrets
# Lines marked "set by wizard" are written programmatically; leave blank here.

# Core
GEODEPLOY_SECRET_KEY=change-this-to-a-long-random-string
# The API process's own bind INSIDE its container. Not the host. See GEODEPLOY_HTTP_* below, which
# is the setting people actually mean when they say "which port is GeoDeploy on".
GEODEPLOY_HOST=0.0.0.0
GEODEPLOY_PORT=8000

# ── How GeoDeploy is published on THIS MACHINE ────────────────────────────────
# NOT the two lines above. GEODEPLOY_HOST/PORT are uvicorn's bind inside the API container; these
# two are the host side of the nginx port publish — the address you type in a browser.
#
#   dedicated     0.0.0.0:80    GeoDeploy is this machine's web server
#   behind-proxy  127.0.0.1:N   only this machine can reach it, and an nginx/Caddy/Apache you
#                               already run publishes it on a domain (docs/behind-a-proxy.md)
#
# Chosen ONCE, by the installer, from your answer — and then left alone. Updates never re-pick it:
# a port that moves on its own silently orphans whatever points at it (your reverse proxy's
# proxy_pass, a DNS record, a bookmark) and looks exactly like a broken install. If the port is
# taken when GeoDeploy starts, it fails and says so rather than moving.
#
# To change it, don't hand-edit — that leaves the running container on the old binding:
#     sudo bash installer/set-port.sh 8081        # move it
#     sudo bash installer/set-port.sh --dedicated # take ports 80
# Both check the target is free first and roll back if nginx does not come up.
#
# Binding 127.0.0.1 is a real security boundary, not a formality: a Docker publish on 0.0.0.0
# inserts its DNAT rule ahead of the host firewall, so `ufw deny 8080` does not keep an
# 0.0.0.0-published port off the internet. Loopback does.
GEODEPLOY_DEPLOY_MODE=dedicated
GEODEPLOY_HTTP_BIND=0.0.0.0
GEODEPLOY_HTTP_PORT=80
# The ports the installer OFFERS while you are choosing one. A suggestion list, nothing more: it is
# read only while a port is being chosen, it is filtered to the ones actually free at that moment,
# and you can always type a port that is not on it.
#
# The two keys do different jobs, and keeping them apart is what stops the port drifting:
#     GEODEPLOY_PORT_CANDIDATES   what to OFFER      — consulted only while choosing
#     GEODEPLOY_HTTP_PORT         what was CHOSEN    — authoritative forever after (above)
# If the installer re-scanned this list on every run, an install that landed on 8081 because 8080
# was busy would move BACK to 8080 the day that service was retired — while the reverse proxy, the
# DNS record and everyone's bookmarks still pointed at 8081.
GEODEPLOY_PORT_CANDIDATES=8080,8081,8082,8090,8880,9080,9090,8008,7080,8888
GEODEPLOY_ENV=production
GEODEPLOY_DATA_DIR=/data
# Extra CORS origins (comma-separated) allowed to call /api cross-origin — e.g. a GeoLibre instance
# whose "Publish to GeoDeploy" plugin POSTs here. Auth on those routes is a Bearer token, not a cookie.
GEODEPLOY_CORS_ORIGINS=
# The deployed git commit — written by installer/{install,update}.sh so the admin Updates panel can
# tell how far behind GitHub the running code is. Leave "unknown"; the installer overwrites it.
GEODEPLOY_GIT_SHA=unknown
# DANGER ZONE — the admin in-container terminal (Settings → Danger Zone). Leave false unless you need
# it. When true it's still admin-only, limited to leaf containers (never api/celery), and audited.
GEODEPLOY_ENABLE_TERMINAL=false

# ── Optional pieces of the stack (uncomment to switch one on) ─────────────────
# COMPOSE_FILE tells the Docker Compose CLI which files make up this stack. It is read from THIS
# file, exactly as COMPOSE_PROFILES below is, so install/update/self-update and the dashboard all
# honour it once it is set. Chain the extras you want with ":" — the first entry must stay
# docker-compose.yml.
#
#   docker-compose.db-port.yml   Reach the PostGIS database from OUTSIDE GeoDeploy — QGIS, psql,
#                                DBeaver, ogr2ogr. By default `postgres` publishes NO host port at
#                                all: it exists only on GeoDeploy's internal Docker network, so
#                                nothing on this machine and nothing on the network can connect to
#                                it. This publishes it on 127.0.0.1:5432, which is reachable over
#                                an SSH tunnel and by nothing else:
#                                    ssh -L 5432:127.0.0.1:5432 you@this-server
#                                GEODEPLOY_POSTGIS_BIND=0.0.0.0 opens it to the network instead —
#                                read the warnings in the file first; a database on the network is
#                                protected by its password and nothing else, and ufw does not cover
#                                a Docker publish. GEODEPLOY_POSTGIS_PORT moves it off 5432.
#
#   docker-compose.tls.yml       Publish host port 443. Only useful once you have provisioned
#                                certificates and uncommented the TLS server block in
#                                nginx/nginx.conf — the base stack terminates plain HTTP and
#                                expects a reverse proxy in front for TLS.
#
# After changing this line:  docker compose up -d --force-recreate <the service it affects>
# COMPOSE_FILE=docker-compose.yml:docker-compose.db-port.yml

# Where the database publishes when docker-compose.db-port.yml is enabled. 127.0.0.1 means "this
# machine only" and is the right answer for an SSH tunnel; see the warnings in that file before
# changing it.
# GEODEPLOY_POSTGIS_BIND=127.0.0.1
# GEODEPLOY_POSTGIS_PORT=5432

# Active Docker Compose profiles — which optional LOCAL containers this install runs.
# Set by the wizard: "local-db" if you let GeoDeploy provision PostGIS, "local-storage" if it
# provisions MinIO (comma-separated; empty when you connect your own external DB/storage).
# docker compose reads this automatically so install/update keep those containers managed.
COMPOSE_PROFILES=

# PostGIS — managed by GeoDeploy (set by wizard)
POSTGIS_HOST=postgres
POSTGIS_PORT=5432
POSTGIS_DB=geodeploy
POSTGIS_USER=geodeploy
POSTGIS_PASSWORD=
# Blank for the local provisioned DB (no TLS). The wizard sets this to "prefer" for an
# existing/external DB; use "require"/"verify-full" for a managed DB that mandates SSL.
POSTGIS_SSLMODE=

# Storage (set by wizard)
STORAGE_TYPE=minio
STORAGE_ENDPOINT=http://minio:9000
STORAGE_BUCKET=geodeploy
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=us-east-1

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# Tile servers
MARTIN_URL=http://martin:3000
MARTIN_CONFIG_PATH=/data/martin/martin-config.yaml
TITILER_URL=http://titiler:80
# Host:port (no scheme) for GDAL/TiTiler S3 access — set by wizard
TITILER_S3_ENDPOINT=
# YES for a real (HTTPS) S3, NO for the local MinIO — set by wizard from the endpoint scheme
TITILER_AWS_HTTPS=NO
# Read-only storage key TiTiler runs as (set by wizard). Left empty here → compose falls back to
# STORAGE_ACCESS_KEY/SECRET. For external S3, set a read-only key so TiTiler never holds a write key.
TITILER_ACCESS_KEY=
TITILER_SECRET_KEY=

# Optional: external S3 override
# STORAGE_TYPE=s3
# STORAGE_ENDPOINT=https://s3.amazonaws.com
# STORAGE_REGION=eu-west-1

# Optional: Sentry
# SENTRY_DSN=

# ── Small-server tuning ───────────────────────────────────────────────────────
# Background worker processes. Each one holds its own copy of the file it is converting, so this
# multiplies MEMORY before it multiplies speed. Set to 1 on a server with 2 GB of RAM or less.
# Also editable from Settings → Infrastructure → Environment.
# CELERY_CONCURRENCY=2
